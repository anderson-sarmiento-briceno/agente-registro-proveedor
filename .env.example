# Copia este archivo como .env y completa los valores.
# .env NO se sube a git (está en .gitignore).

# Clave de Anthropic. Opcional: sin ella funciona el núcleo (scripts/demo.py).
ANTHROPIC_API_KEY=

# Modelo de lenguaje. Por defecto, uno económico.
LLM_MODELO=claude-haiku-5-5

# Esfuerzo del modelo: low, medium, high, xhigh o max. Reemplaza a "temperature".
LLM_ESFUERZO=medium

# Segundos de espera por respuesta, reintentos ante fallas pasajeras y tope de tokens.
LLM_TIMEOUT_S=30
LLM_REINTENTOS=3
LLM_MAX_TOKENS=4000

# Topes del agente: consultas al modelo por turno, tokens por conversación
# (sin contar los leídos de la caché, que son casi gratis) y mensajes por conversación.
LLM_MAX_ITERACIONES=15
LLM_TOPE_TOKENS_SESION=300000
LLM_MAX_MENSAJES_SESION=30

# Topes de la demo abierta (sin clave de acceso). Por visitante (dirección IP):
TOPE_CONVERSACIONES_HORA_IP=5
TOPE_MENSAJES_MINUTO_IP=10
# Para todos los visitantes juntos, por día (se guarda en out/uso-diario.json):
TOPE_CONVERSACIONES_DIA=100
TOPE_USD_DIA=2.0

# Fecha de ejecución (RN7), formato AAAA-MM-DD. Vacía = fecha de hoy.
FECHA_EJECUCION=

# Nivel de los logs: DEBUG, INFO, WARNING o ERROR.
NIVEL_LOG=INFO
